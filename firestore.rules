rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /suggestions/{id} {
      allow create: if request.resource.data.keys().hasOnly(['text','name','user','at','v'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24;
      allow read, delete: if request.auth != null
        && request.auth.token.email == 'mattdub@players.example.com';
    }
    match /announcements/{id} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'mattdub@players.example.com';
      match /votes/{uid} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.o is int
          && request.resource.data.o >= 0
          && request.resource.data.o < 5;
      }
    }
    match /friendReqs/{id} {
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if request.auth != null
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid
        && request.resource.data.status == 'accepted';
      allow delete: if request.auth != null
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
    }
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /invites/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
    }
  }
}
