rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isDev() {
      return request.auth != null && request.auth.token.email == 'mattdub@players.example.com';
    }
    // Slime Bucks: `bucks` is the total a player has ever earned. It can only grow as fast as real play can earn
    // (40 at once, plus 60 per minute since the last save), so editing the number in the browser gets rejected.
    // Saves from before this rule (no `bucks` yet) can start at up to 20000.
    function bucksOk() {
      let nb = request.resource.data.get('bucks', 0);
      return nb is int && nb >= 0
        && request.resource.data.updatedAt == request.time
        && ((resource == null || !('bucks' in resource.data))
            ? nb <= 20000
            : nb <= resource.data.bucks + 40 + (request.time.toMillis() - resource.data.updatedAt.toMillis()) / 60000 * 60);
    }
    // Slime-ate tokens: `slimeate` is the list of times (ms) a player found one. It can only grow by one entry per save,
    // the new entry must be from the last 30 days (and not the future), and at least 180 days after the previous one.
    function slimeateOk() {
      let n = request.resource.data.get('slimeate', []);
      let o = resource == null ? [] : resource.data.get('slimeate', []);
      let now = request.time.toMillis();
      return n == o
        || (n is list && n.size() == o.size() + 1 && n.size() <= 20
            && (o.size() == 0 || n[0:o.size()] == o)
            && n[o.size()] is int
            && n[o.size()] <= now + 300000
            && n[o.size()] > now - 2592000000
            && (o.size() == 0 || n[o.size()] - o[o.size() - 1] > 15552000000));
    }
    match /saves/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isDev());
      allow create, update: if request.auth != null && request.auth.uid == uid && bucksOk() && slimeateOk();
      // the dev can correct a player's Slime Bucks (and nothing else in their save)
      allow update: if isDev()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bucks', 'updatedAt'])
        && request.resource.data.bucks is int && request.resource.data.bucks >= 0;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /suggestions/{id} {
      allow create: if request.resource.data.keys().hasOnly(['text','name','user','at','v'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24;
      allow read, delete: if request.auth != null
        && request.auth.token.email == 'mattdub@players.example.com';
    }
    match /announcements/{id} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'mattdub@players.example.com';
      match /votes/{uid} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.o is int
          && request.resource.data.o >= 0
          && request.resource.data.o < 5;
      }
    }
    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 12;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && (request.resource.data.members == resource.data.members
            || resource.data.createdBy == request.auth.uid);
      match /messages/{msgId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if request.auth != null
          && request.resource.data.from == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && (!('text' in request.resource.data)
              || (request.resource.data.text is string && request.resource.data.text.size() <= 500));
      }
    }
    match /sharedReplays/{rid} {
      allow read: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.members;
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.members;
      match /chunks/{chunkId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(get(/databases/$(database)/documents/sharedReplays/$(rid)).data.chatId)).data.members;
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/sharedReplays/$(rid)).data.from == request.auth.uid;
      }
    }
    match /friendReqs/{id} {
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if request.auth != null
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid
        && request.resource.data.status == 'accepted';
      allow delete: if request.auth != null
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
    }
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /invites/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
    }
  }
}
